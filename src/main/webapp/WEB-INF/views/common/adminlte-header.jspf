<%@ page pageEncoding="UTF-8" %>
<%@ page import="org.springframework.web.util.HtmlUtils" %>
<%
    boolean hrmsLteHeaderIsAdmin = request.isUserInRole("HR_ADMIN");
    String hrmsLteLoginId = request.getUserPrincipal() != null
        ? request.getUserPrincipal().getName() : "ユーザー";
%>
<nav class="main-header navbar navbar-expand navbar-white navbar-light" aria-label="ユーザーメニュー">
    <ul class="navbar-nav">
        <li class="nav-item">
            <button type="button" class="nav-link hrms-lte-toggle" data-widget="pushmenu"
                    aria-controls="hrms-lte-sidebar" aria-expanded="true" aria-label="サイドバーを折りたたむ・展開する">
                <span aria-hidden="true">&#9776;</span>
            </button>
        </li>
    </ul>
    <ul class="navbar-nav ml-auto">
        <li class="nav-item dropdown">
            <button type="button" class="nav-link btn btn-light hrms-lte-profile" id="hrms-lte-profile"
                    data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <%= hrmsLteHeaderIsAdmin ? "管理者" : "社員" %> <span aria-hidden="true">&#9662;</span>
            </button>
            <div class="dropdown-menu dropdown-menu-right" aria-labelledby="hrms-lte-profile">
                <div class="dropdown-header"><%= HtmlUtils.htmlEscape(hrmsLteLoginId) %></div>
                <div class="dropdown-divider"></div>
                <a href="${pageContext.request.contextPath}/mypage" class="dropdown-item">プロフィール</a>
                <a href="${pageContext.request.contextPath}/employee/myedit" class="dropdown-item">プロフィール編集</a>
                <% if (hrmsLteHeaderIsAdmin) { %>
                <a href="${pageContext.request.contextPath}/admin/accounts" class="dropdown-item">権限付与管理</a>
                <% } %>
                <div class="dropdown-divider"></div>
                <form action="${pageContext.request.contextPath}/logout" method="post" class="mb-0">
                    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
                    <button type="submit" class="dropdown-item text-danger">ログアウト</button>
                </form>
            </div>
        </li>
    </ul>
</nav>
